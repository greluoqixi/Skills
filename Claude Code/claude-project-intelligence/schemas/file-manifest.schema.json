{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:claude-project-intelligence:file-manifest-record:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["path", "module", "role", "language", "generated", "size", "hash", "mode"],
  "properties": {
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\\\\\u0000]+$"},
    "module": {"type": "string"},
    "role": {"enum": ["entrypoint", "test", "domain-model", "adapter", "config", "other"]},
    "language": {"type": "string", "maxLength": 40},
    "generated": {"type": "boolean"},
    "size": {"type": "integer", "minimum": 0},
    "hash": {"type": "string", "pattern": "^sha256:(?:[0-9a-f]{64}|symlink)$"},
    "mode": {"enum": ["file", "symlink", "submodule"]},
    "extensions": {"type": "object"}
  }
}
