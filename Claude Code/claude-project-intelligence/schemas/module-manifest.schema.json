{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:claude-project-intelligence:module-manifest-record:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "path", "file_count", "structure_hash"],
  "properties": {
    "id": {"type": "string"},
    "path": {"type": "string"},
    "file_count": {"type": "integer", "minimum": 0},
    "structure_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "extensions": {"type": "object"}
  }
}
