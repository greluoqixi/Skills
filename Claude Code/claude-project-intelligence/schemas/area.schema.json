{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:claude-project-intelligence:area:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "summary", "routing_terms", "modules"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "maxLength": 120},
    "summary": {"type": "string", "maxLength": 500},
    "routing_terms": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 80}},
    "modules": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/moduleId"}},
    "child_areas": {"type": "array", "maxItems": 20, "items": {"type": "string"}},
    "public_dependencies": {"type": "array", "maxItems": 30, "items": {"type": "string"}},
    "extensions": {"type": "object"}
  },
  "$defs": {
    "moduleId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)*$", "maxLength": 128}
  }
}
